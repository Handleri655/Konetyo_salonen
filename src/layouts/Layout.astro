---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { withBase } from "../lib/paths";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: string;
}

const { title, description, image = "/images/hero.jpg", lang = "fi" } = Astro.props;
const canonical = Astro.url.href.split("?")[0].replace(/\/$/, "") || site.url;
const ogImage = `${import.meta.env.SITE}${withBase(image)}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: site.name,
  url: site.url,
  telephone: "+358449916035",
  email: site.email,
  image: ogImage,
  vatID: site.yTunnus,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: "FI",
  },
  areaServed: ["Pello", "Ylitornio", "Kolari", "Lappi"],
  openingHours: "Mo-Fr 08:00-15:00",
  geo: {
    "@type": "GeoCoordinates",
    latitude: 66.76396,
    longitude: 23.94873,
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/logo.webp")} type="image/webp" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesk:opsz,wght@12..96,500;12..96,700;12..96,800&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#173027" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#sisalto">Siirry sisältöön</a>
    <Header />
    <main id="sisalto">
      <slot />
    </main>
    <Footer />
  </body>
</html>
